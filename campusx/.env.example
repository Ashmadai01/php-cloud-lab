# SDUT Swap environment — copy to .env and fill in real values. NEVER commit .env.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_NAME=SDUT Swap
# Times are stored in UTC and displayed in this time zone.
DISPLAY_TIMEZONE=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campusx
DB_USER=campusx_app
DB_PASS=change-me-strong-password
DB_CHARSET=utf8mb4
# Optional: separate privileged account used ONLY by tools/upgrade.php (needs ALTER/CREATE/INDEX).
DB_MIGRATE_USER=
DB_MIGRATE_PASS=

# Session
SESSION_LIFETIME=7200
SESSION_IDLE_TIMEOUT=1800

# Mail (SMTP). Leave MAIL_ENABLED=false to log mail to storage/logs/mail.log in local dev.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=SDUT Swap

# Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=storage/uploads
PRIVATE_DIR=storage/private

# Policy
REQUIRE_VERIFIED_TO_LIST=true
REQUIRE_VERIFIED_TO_CHAT=true
REQUIRE_EMAIL_VERIFICATION=true
ALLOWED_EMAIL_DOMAINS=

# Security
TRUSTED_PROXIES=
# How long (seconds) an admin's password confirmation stays valid for sensitive actions.
ADMIN_REAUTH_TTL=600
# Retention: private files are deleted by `php tools/purge_private_files.php` (run it daily from cron / Task Scheduler).
CARD_RETENTION_DAYS=30
EVIDENCE_RETENTION_DAYS=180
# Optional: receive an email for high-severity security events (needs MAIL_ENABLED=true to actually send).
SECURITY_ALERT_EMAIL=
